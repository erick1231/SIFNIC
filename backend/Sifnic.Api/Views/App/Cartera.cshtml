@{
    ViewData["Title"] = "Cartera y Cobranza";
}
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIFNIC | Cartera y Cobranza</title>
    <meta name="description" content="Modulo operativo de cartera, cobranza, mora y seguimiento." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script src="~/js/shared/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/ux-guidance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/modules/creditos/assets/css/creditos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/finance-design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enterprise-system.css" asp-append-version="true" />
  </head>
  <body class="portfolio2-page fin-page">
    <main class="portfolio2-shell">
      <header class="portfolio2-header">
        <div class="portfolio2-title-row">
          <button class="ghost-button" id="backToDashboard" type="button">Volver al panel</button>
          <div class="title-block">
            <span class="eyebrow">Cartera y Cobranza</span>
            <h1>Cartera y Cobranza</h1>
            <p>Gestiona, monitorea y da seguimiento operativo a la cartera.</p>
          </div>
        </div>
        <div class="portfolio2-session">
          <button class="ghost-button theme-toggle-header" id="themeToggle" type="button" aria-pressed="false">
            <span id="themeToggleLabel">Modo oscuro</span>
          </button>
          <div class="session-chip">
            <strong id="sessionUser">Usuario</strong>
            <span id="sessionMeta">Sesion activa</span>
          </div>
          <button class="ghost-button" id="closeSession" type="button">Cerrar sesion</button>
        </div>
      </header>

      <section class="portfolio2-filterbar" aria-label="Filtros de cartera">
        <label class="field portfolio2-search">
          <span>Buscar</span>
          <input id="searchInput" type="search" placeholder="Credito, cliente o cedula" />
        </label>
        <label class="field">
          <span>Estado</span>
          <select id="statusFilter"></select>
        </label>
        <label class="field" id="officerField">
          <span>Oficial</span>
          <select id="officerFilter"></select>
        </label>
        <label class="field">
          <span>Fecha corte</span>
          <input id="cutoffDate" type="date" />
        </label>
        <div class="portfolio2-filter-actions">
          <button class="primary-button" id="refreshButton" type="button">Actualizar</button>
          <button class="ghost-button" id="clearButton" type="button">Limpiar</button>
          <button class="ghost-button" id="regulatoryButton" type="button">CONAMI</button>
        </div>
      </section>

      <section class="portfolio2-kpis" aria-label="Resumen operativo">
        <article class="portfolio2-kpi">
          <span>Creditos</span>
          <strong id="metricCredits">0</strong>
          <small id="metricScope">GLOBAL</small>
        </article>
        <article class="portfolio2-kpi">
          <span>Saldo capital</span>
          <strong id="metricBalance">0.00</strong>
          <small>Total cartera</small>
        </article>
        <article class="portfolio2-kpi is-danger">
          <span>Saldo vencido</span>
          <strong id="metricOverdue">0.00</strong>
          <small>Total vencido</small>
        </article>
        <article class="portfolio2-kpi is-warning">
          <span>Creditos en mora</span>
          <strong id="metricOverdueCredits">0</strong>
          <small>Mayor o igual a 1 dia</small>
        </article>
        <article class="portfolio2-kpi">
          <span>Sin oficial</span>
          <strong id="metricUnassigned">0</strong>
          <small>Asignacion pendiente</small>
        </article>
      </section>

      <nav class="portfolio2-segments" aria-label="Vistas de cartera">
        <button class="portfolio2-segment is-active" id="portfolioModeButton" type="button" data-screen="activa">
          <span>Cartera activa</span>
          <strong id="portfolioModeMeta">0</strong>
        </button>
        <button class="portfolio2-segment" id="overdueModeButton" type="button" data-screen="mora">
          <span>Mora / Cobranza</span>
          <strong id="overdueModeMeta">0</strong>
        </button>
        <button class="portfolio2-segment" id="restructuredModeButton" type="button" data-screen="reestructurados">
          <span>Reestructurados</span>
          <strong id="restructuredModeMeta">0</strong>
        </button>
        <button class="portfolio2-segment" id="unassignedModeButton" type="button" data-screen="sin-oficial">
          <span>Sin oficial</span>
          <strong id="unassignedModeMeta">0</strong>
        </button>
        <button class="portfolio2-segment" id="analyticsModeButton" type="button" data-screen="analitica">
          <span>Analitica / recuperacion</span>
          <strong id="recoverySegmentMeta">Diaria</strong>
        </button>
      </nav>

      <section class="portfolio2-workspace" id="portfolioWorkspace" data-screen="activa">
        <section class="portfolio2-main">
          <section class="portfolio2-insights" id="portfolioInsightStrip">
            <article>
              <span>Foco operativo</span>
              <strong>Filtra, selecciona un credito y gestiona segun prioridad.</strong>
            </article>
            <article>
              <span>Accion sugerida</span>
              <strong>La vista Mora muestra solo creditos con 1+ dia de atraso.</strong>
            </article>
          </section>

          <section class="portfolio2-table-card" id="portfolioTableCard">
            <div class="portfolio2-section-head">
              <div>
                <span class="eyebrow" id="tableEyebrow">Cartera activa</span>
                <h2 id="tableTitle">Creditos activos</h2>
              </div>
              <span class="counter-pill" id="tableCounter">0 registros</span>
            </div>
            <div class="portfolio2-table-wrap">
              <table class="data-table portfolio2-table">
                <thead>
                  <tr>
                    <th>No. credito</th>
                    <th>Cliente</th>
                    <th>Oficial</th>
                    <th>Saldo</th>
                    <th>Vencido</th>
                    <th>Proxima cuota</th>
                    <th>Ultimo pago</th>
                    <th>Riesgo</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody id="tableBody"></tbody>
              </table>
            </div>
          </section>

          <section class="portfolio2-analytics" id="analyticsPanel" hidden>
            <div class="portfolio2-section-head">
              <div>
                <span class="eyebrow">Cobranza</span>
                <h2>Analitica y recuperacion</h2>
              </div>
              <div class="portfolio2-inline-actions">
                <label class="field">
                  <span>Fecha</span>
                  <input id="recoveryDate" type="date" />
                </label>
                <button class="ghost-button" id="refreshRecoveryButton" type="button">Actualizar</button>
              </div>
            </div>
            <div class="portfolio2-analytics-grid">
              <section class="portfolio2-card">
                <h3>Tramos de mora</h3>
                <div class="mora-bucket-grid" id="moraBucketGrid"></div>
              </section>
              <section class="portfolio2-card">
                <h3>Recuperacion diaria</h3>
                <span class="counter-pill" id="recoveryProgress">0%</span>
                <div class="detail-grid cartera-recovery-summary" id="recoverySummary"></div>
              </section>
            </div>
            <div class="portfolio2-table-wrap compact">
              <table class="data-table cartera-recovery-table">
                <thead>
                  <tr>
                    <th>Oficial</th>
                    <th>Creditos</th>
                    <th>A recuperar</th>
                    <th>Recuperado</th>
                    <th>Pendiente</th>
                    <th>Avance</th>
                  </tr>
                </thead>
                <tbody id="recoveryBody"></tbody>
              </table>
            </div>
          </section>

          <section class="portfolio2-mora-hidden" id="moraPanel" hidden>
            <span id="moraPanelCounter">0 creditos</span>
            <table><tbody id="moraBody"></tbody></table>
          </section>
        </section>

        <aside class="portfolio2-detail" id="detailPanel">
          <div class="portfolio2-detail-head">
            <div>
              <span class="eyebrow">Credito seleccionado</span>
              <h2 id="detailTitle">Sin seleccion</h2>
            </div>
            <button class="ghost-button detail-toggle-button" id="detailToggleButton" type="button" aria-expanded="true">
              <span id="detailToggleIcon">Cerrar</span>
            </button>
          </div>

          <nav class="portfolio2-detail-tabs" aria-label="Detalle del credito">
            <button class="is-active" type="button" data-detail-tab="resumen">Resumen</button>
            <button type="button" data-detail-tab="pagos">Pagos</button>
            <button type="button" data-detail-tab="plan">Plan de pago</button>
            <button type="button" data-detail-tab="gestion">Gestion</button>
          </nav>

          <section class="portfolio2-detail-body">
            <div class="portfolio2-tab-panel is-active" data-detail-panel="resumen">
              <div class="portfolio2-loan-status">
                <span class="status-pill" id="detailStatus">-</span>
                <span class="status-pill" id="detailRisk">-</span>
              </div>
              <div class="portfolio2-summary-grid" id="detailBody"></div>
              <div class="portfolio2-summary-grid compact" id="nextQuotaBody"></div>
            </div>
            <div class="portfolio2-tab-panel" data-detail-panel="pagos">
              <div id="paymentsBody"></div>
            </div>
            <div class="portfolio2-tab-panel" data-detail-panel="plan">
              <div id="planBody"></div>
              <div id="ratesBody"></div>
            </div>
            <div class="portfolio2-tab-panel" data-detail-panel="gestion">
              <div id="managementBody"></div>
            </div>
          </section>

          <section class="portfolio2-actions">
            <span>Acciones</span>
            <button class="primary-button" id="managementButton" type="button">Gestionar seguimiento</button>
            <button class="ghost-button" id="statementButton" type="button">Estado de cuenta</button>
            <button class="ghost-button" id="planButton" type="button">Plan de pago</button>
            <button class="ghost-button" id="assignButton" type="button">Asignar</button>
            <button class="danger-button" id="unassignButton" type="button">Desasignar</button>
            <button class="ghost-button portfolio2-bridge" id="prepareCashButton" type="button">Preparar atencion en caja</button>
            <button class="ghost-button" id="refreshDetailButton" type="button">Recargar</button>
          </section>
        </aside>
      </section>
    </main>

    <div class="modal-backdrop" id="managementBackdrop" hidden>
      <section class="modal-shell" role="dialog" aria-modal="true" aria-labelledby="managementTitle">
        <header class="modal-head">
          <div>
            <span class="eyebrow">Cobranza</span>
            <h2 id="managementTitle">Registrar seguimiento</h2>
          </div>
          <button class="ghost-button" id="managementClose" type="button">Cerrar</button>
        </header>
        <form class="ops-form" id="managementForm">
          <section class="form-section">
            <h3 id="managementCreditTitle">Credito</h3>
            <div class="form-grid">
              <label class="field">
                <span>Tipo de gestion</span>
                <select id="managementType">
                  <option value="LLAMADA">Llamada</option>
                  <option value="VISITA">Visita</option>
                  <option value="PROMESA">Promesa de pago</option>
                  <option value="SEGUIMIENTO">Seguimiento</option>
                </select>
              </label>
              <label class="field">
                <span>Resultado</span>
                <select id="managementResult">
                  <option value="CONTACTADO">Contactado</option>
                  <option value="NO_LOCALIZADO">No localizado</option>
                  <option value="PROMESA">Promesa registrada</option>
                  <option value="ESCALAR">Escalar</option>
                </select>
              </label>
              <label class="field">
                <span>Fecha promesa</span>
                <input id="promiseDate" type="date" />
              </label>
              <label class="field">
                <span>Monto promesa</span>
                <input id="promiseAmount" type="number" min="0" step="0.01" />
              </label>
              <label class="field field-wide">
                <span>Observacion</span>
                <textarea id="managementObservation" rows="4" maxlength="1000" placeholder="Detalle breve de contacto, acuerdo o siguiente accion."></textarea>
              </label>
            </div>
          </section>
          <div class="form-message" id="managementMessage" hidden></div>
          <footer class="modal-actions">
            <button class="ghost-button" id="managementCancel" type="button">Cancelar</button>
            <button class="primary-button" id="managementSubmit" type="submit">Guardar seguimiento</button>
          </footer>
        </form>
      </section>
    </div>

    <div class="modal-backdrop" id="assignmentBackdrop" hidden>
      <section class="modal-shell" role="dialog" aria-modal="true" aria-labelledby="assignmentTitle">
        <header class="modal-head">
          <div>
            <span class="eyebrow">Cartera</span>
            <h2 id="assignmentTitle">Asignar cartera</h2>
          </div>
          <button class="ghost-button" id="assignmentClose" type="button">Cerrar</button>
        </header>
        <form class="ops-form" id="assignmentForm">
          <section class="form-section">
            <h3 id="assignmentCreditTitle">Prestamo</h3>
            <div class="form-grid">
              <label class="field" id="assignmentOfficerField"><span>Nuevo oficial</span><select id="assignmentOfficer"></select></label>
              <label class="field field-wide"><span>Motivo</span><input id="assignmentReason" maxlength="600" required /></label>
              <label class="field field-wide"><span>Observacion</span><input id="assignmentObservation" maxlength="1000" /></label>
            </div>
          </section>
          <div class="form-message" id="assignmentMessage" hidden></div>
          <footer class="modal-actions">
            <button class="ghost-button" id="assignmentCancel" type="button">Cancelar</button>
            <button class="primary-button" id="assignmentSubmit" type="submit">Confirmar</button>
          </footer>
        </form>
      </section>
    </div>

    <div class="modal-backdrop" id="regulatoryBackdrop" hidden>
      <section class="modal-shell modal-wide" role="dialog" aria-modal="true" aria-labelledby="regulatoryTitle">
        <header class="modal-head">
          <div>
            <span class="eyebrow">Cartera regulatoria</span>
            <h2 id="regulatoryTitle">Cierre CONAMI</h2>
          </div>
          <button class="ghost-button" id="regulatoryClose" type="button">Cerrar</button>
        </header>
        <section class="regulatory-shell">
          <aside class="regulatory-controls">
            <label class="field"><span>Fecha corte</span><input id="regulatoryCutoffDate" type="date" /></label>
            <label class="field">
              <span>Tipo cierre</span>
              <select id="regulatoryClosureType">
                <option value="DIARIO">DIARIO</option>
                <option value="MENSUAL">MENSUAL</option>
                <option value="QA">QA</option>
              </select>
            </label>
            <label class="field regulatory-check">
              <input id="regulatoryReprocess" type="checkbox" checked />
              <span>Reprocesar el corte si ya existe</span>
            </label>
            <div class="toolbar-actions regulatory-action-stack">
              <button class="primary-button" id="regulatoryPreview" type="button">Calcular</button>
              <button class="ghost-button" id="regulatoryPersist" type="button">Guardar cierre</button>
              <button class="ghost-button" id="regulatoryExport" type="button">CSV</button>
            </div>
            <div class="form-message" id="regulatoryMessage" hidden></div>
          </aside>
          <section class="regulatory-results">
            <div class="detail-grid regulatory-totals" id="regulatoryTotals"></div>
            <div class="related-panel" id="regulatorySummary"></div>
            <div class="table-wrap regulatory-table-wrap">
              <table class="data-table regulatory-table">
                <thead>
                  <tr>
                    <th>Ciclo</th>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th>Mora</th>
                    <th>Categoria</th>
                    <th>Provision</th>
                    <th>Saldo</th>
                  </tr>
                </thead>
                <tbody id="regulatoryBody"></tbody>
              </table>
            </div>
          </section>
        </section>
      </section>
    </div>

    <script src="~/js/shared/auth-session.js" asp-append-version="true"></script>
    <script src="~/modules/creditos/cartera.js" asp-append-version="true"></script>
    <script src="~/js/shared/ux-guidance.js" asp-append-version="true"></script>
  </body>
</html>
