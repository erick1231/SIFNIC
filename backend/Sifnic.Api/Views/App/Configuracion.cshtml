@{
    ViewData["Title"] = "Configuracion";
}
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIFNIC | Configuracion</title>
    <meta
      name="description"
      content="Administracion de usuarios, claves y bitacoras del sistema."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script src="~/js/shared/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/ux-guidance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/config.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enterprise-system.css" asp-append-version="true" />
  </head>
  <body>
    <div class="page-aura page-aura-left" aria-hidden="true"></div>
    <div class="page-aura page-aura-right" aria-hidden="true"></div>

    <main class="config-shell">
      <header class="topbar">
        <div class="topbar-group">
          <button class="ghost-button" id="backToDashboard" type="button">
            Panel principal
          </button>

          <div class="title-block">
            <span class="eyebrow">Seguridad</span>
            <h1>Configuracion</h1>
          </div>
        </div>

        <div class="topbar-group topbar-group-right">
          <button class="ghost-button theme-toggle-header" id="themeToggle" type="button" aria-pressed="false" data-theme-toggle>
            <span id="themeToggleLabel" data-theme-label>Modo oscuro</span>
          </button>

          <div class="session-chip">
            <strong id="sessionUser">Usuario</strong>
            <span id="sessionMeta">Sesion activa</span>
          </div>

          <button class="ghost-button" id="logoutButton" type="button">
            Cerrar sesion
          </button>
        </div>
      </header>

      <section class="board-card">
        <header class="board-head">
          <div class="board-copy">
            <span class="eyebrow">Panel administrativo</span>
            <h2>Centro de configuracion del sistema</h2>
            <p>
              Administra un dominio a la vez con cambios trazables y controles visibles.
            </p>
          </div>

          <button class="primary-button" id="refreshCurrentView" type="button">
            Actualizar vista
          </button>
        </header>

        <section class="enterprise-next-action config-next-action" aria-label="Accion recomendada de configuracion">
          <div>
            <span class="eyebrow">Siguiente accion</span>
            <strong>Selecciona una seccion, revisa cambios y guarda sin mezclar dominios</strong>
            <p>La navegacion izquierda define el contexto; el panel activo mantiene el foco tecnico.</p>
          </div>
          <a class="primary-button" href="#configLayout">Ir a secciones</a>
        </section>

        <section class="metrics-grid">
          <article class="metric-card">
            <span class="metric-label">Usuarios activos</span>
            <strong class="metric-value" id="metricActiveUsers">0</strong>
            <small class="metric-meta">Colaboradores habilitados para entrar</small>
          </article>

          <article class="metric-card">
            <span class="metric-label">Clave temporal</span>
            <strong class="metric-value" id="metricPendingReset">0</strong>
            <small class="metric-meta">Usuarios obligados a cambiar clave</small>
          </article>

          <article class="metric-card">
            <span class="metric-label">Accesos recientes</span>
            <strong class="metric-value" id="metricAccessRows">0</strong>
            <small class="metric-meta">Eventos leidos de bitacora de acceso</small>
          </article>

          <article class="metric-card">
            <span class="metric-label">Movimientos recientes</span>
            <strong class="metric-value" id="metricMovementRows">0</strong>
            <small class="metric-meta">Eventos leidos de bitacora operativa</small>
          </article>
        </section>

        <div class="config-layout" id="configLayout">
          <aside class="config-rail">
            <section class="rail-card rail-card-nav">
              <div class="rail-card-head">
                <span class="eyebrow">Navegacion</span>
                <strong>Secciones del modulo</strong>
                <p>Activa una sola vista operativa a la vez y trabaja por bloques sin tener toda la configuracion apilada en una sola pantalla.</p>
              </div>

              <nav class="tab-row" id="tabRow" aria-label="Vistas de configuracion">
                <button class="tab-button is-active" type="button" data-tab="general">
                  General
                </button>
                <button class="tab-button" type="button" data-tab="reportes">
                  Reportes y branding
                </button>
                <button class="tab-button" type="button" data-tab="seguridad">
                  Seguridad
                </button>
                <button class="tab-button" type="button" data-tab="rrhh">
                  Capital humano
                </button>
                <button class="tab-button" type="button" data-tab="nomina">
                  Nomina
                </button>
                <button class="tab-button" type="button" data-tab="tipo-cambio">
                  Tipo de cambio
                </button>
                <button class="tab-button" type="button" data-tab="conami">
                  Normativa CONAMI
                </button>
                <button class="tab-button" type="button" data-tab="creditos">
                  Tipos de credito
                </button>
                <button class="tab-button" type="button" data-tab="usuarios">
                  Listado de usuarios
                </button>
                <button class="tab-button" type="button" data-tab="accesos">
                  Bitacora de accesos
                </button>
                <button class="tab-button" type="button" data-tab="movimientos">
                  Bitacora de movimientos
                </button>
              </nav>

              <div class="rail-note">
                <strong>Vista activa</strong>
                <p>Los paneles se cargan por dominio. Seguridad administra bloqueos y resets; RRHH solo enlaza catalogos y accesos operativos.</p>
              </div>
            </section>
          </aside>

          <div class="config-stage" id="panelStage">
        <section class="panel-card" id="generalPanel">
          <div class="panel-head">
            <div>
              <span class="eyebrow">Sistema</span>
              <h3>Identidad de empresa y sistema</h3>
            </div>
            <p class="panel-note">
              Estos datos alimentan nombre del sistema, encabezados base y la informacion
              corporativa que luego reutilizan varios modulos.
            </p>
          </div>

          <input id="generalCompanyId" type="hidden" />
          <input id="generalConfigId" type="hidden" />

          <nav class="section-switcher" aria-label="Secciones de configuracion general">
            <button class="section-switch is-active" type="button" data-section-scope="general" data-section-target="empresa">
              Empresa
            </button>
            <button class="section-switch" type="button" data-section-scope="general" data-section-target="sistema">
              Sistema
            </button>
          </nav>

          <div class="section-stage">
            <article class="settings-section" data-section-panel="general:empresa">
              <header class="settings-section-head">
                <span class="eyebrow">Empresa</span>
                <strong>Datos corporativos</strong>
              </header>

              <div class="field-grid field-grid-two">
                <label class="form-field">
                  <span>Razon social</span>
                  <input id="companyLegalNameInput" type="text" maxlength="300" />
                </label>

                <label class="form-field">
                  <span>Nombre comercial</span>
                  <input id="companyTradeNameInput" type="text" maxlength="300" />
                </label>

                <label class="form-field">
                  <span>RUC</span>
                  <input id="companyRucInput" type="text" maxlength="100" />
                </label>

                <label class="form-field">
                  <span>Telefono empresa</span>
                  <input id="companyPhoneInput" type="text" maxlength="100" />
                </label>

                <label class="form-field">
                  <span>Correo empresa</span>
                  <input id="companyEmailInput" type="email" maxlength="300" />
                </label>

                <label class="form-field field-span-2">
                  <span>Direccion</span>
                  <textarea id="companyAddressInput" rows="3" maxlength="1000"></textarea>
                </label>
              </div>
            </article>

            <article class="settings-section" data-section-panel="general:sistema" hidden>
              <header class="settings-section-head">
                <span class="eyebrow">Sistema</span>
                <strong>Presentacion general</strong>
              </header>

              <div class="field-grid">
                <label class="form-field">
                  <span>Nombre del sistema</span>
                  <input id="systemNameInput" type="text" maxlength="300" />
                  <small class="field-help">Se usa en reportes, login y encabezados generales.</small>
                </label>

                <label class="form-field">
                  <span>Tema o color de referencia</span>
                  <input id="themeColorInput" type="text" maxlength="120" placeholder="azul" />
                </label>

                <label class="form-field">
                  <span>Logo principal de la empresa</span>
                  <input id="companyLogoUrlInput" type="text" maxlength="1000" placeholder="/uploads/branding/logo.png" />
                </label>

                <div class="upload-card">
                  <div class="upload-copy">
                    <strong>Logo corporativo principal</strong>
                    <small>Este puede reutilizarse luego en reportes, panel y otras vistas.</small>
                  </div>

                  <div class="upload-actions">
                    <button class="ghost-button" id="uploadCompanyLogoButton" type="button">
                      Cargar imagen
                    </button>
                    <input id="companyLogoUploadInput" type="file" accept=".png,.jpg,.jpeg,.webp,.svg" hidden />
                  </div>

                  <div class="logo-preview-shell" id="companyLogoPreviewShell" hidden>
                    <img id="companyLogoPreview" class="logo-preview" alt="Logo principal" />
                  </div>
                </div>
              </div>
            </article>
          </div>

          <footer class="panel-actions">
            <button class="primary-button" id="saveGeneralButton" type="button">
              Guardar configuracion general
            </button>
          </footer>
        </section>

        <section class="panel-card" id="reportPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Branding</span>
              <h3>Reportes, logos y soporte</h3>
            </div>
            <p class="panel-note">
              Define el nombre y el logo que viajaran en los reportes, el logo de acceso y el
              pie institucional del sistema.
            </p>
          </div>

          <nav class="section-switcher" aria-label="Secciones de branding y reportes">
            <button class="section-switch is-active" type="button" data-section-scope="reportes" data-section-target="logos">
              Logos
            </button>
            <button class="section-switch" type="button" data-section-scope="reportes" data-section-target="soporte">
              Soporte
            </button>
          </nav>

          <div class="section-stage">
            <article class="settings-section" data-section-panel="reportes:logos">
              <header class="settings-section-head">
                <span class="eyebrow">Imagen corporativa</span>
                <strong>Logos visibles</strong>
              </header>

              <div class="field-grid">
                <label class="form-field">
                  <span>Logo para reportes y panel</span>
                  <input id="reportLogoUrlInput" type="text" maxlength="1000" placeholder="/uploads/branding/logo-reportes.png" />
                </label>

                <div class="upload-card">
                  <div class="upload-copy">
                    <strong>Logo de reportes y panel</strong>
                    <small>Se usa como imagen corporativa general donde el sistema pide branding.</small>
                  </div>
                  <div class="upload-actions">
                    <button class="ghost-button" id="uploadReportLogoButton" type="button">
                      Cargar imagen
                    </button>
                    <input id="reportLogoUploadInput" type="file" accept=".png,.jpg,.jpeg,.webp,.svg" hidden />
                  </div>
                  <div class="logo-preview-shell" id="reportLogoPreviewShell" hidden>
                    <img id="reportLogoPreview" class="logo-preview" alt="Logo de reportes" />
                  </div>
                </div>

                <label class="form-field">
                  <span>Logo para login</span>
                  <input id="loginLogoUrlInput" type="text" maxlength="1000" placeholder="/uploads/branding/logo-login.png" />
                </label>

                <div class="upload-card">
                  <div class="upload-copy">
                    <strong>Logo de acceso seguro</strong>
                    <small>Se muestra en la pantalla de inicio si la opcion queda activa.</small>
                  </div>
                  <div class="upload-actions">
                    <button class="ghost-button" id="uploadLoginLogoButton" type="button">
                      Cargar imagen
                    </button>
                    <input id="loginLogoUploadInput" type="file" accept=".png,.jpg,.jpeg,.webp,.svg" hidden />
                  </div>
                  <div class="logo-preview-shell" id="loginLogoPreviewShell" hidden>
                    <img id="loginLogoPreview" class="logo-preview" alt="Logo de login" />
                  </div>
                </div>

                <label class="switch-field">
                  <input id="showLoginLogoInput" type="checkbox" />
                  <span class="switch-copy">
                    <strong>Mostrar logo en login</strong>
                    <small>Si se desactiva, el acceso usa solo texto y marca base del sistema.</small>
                  </span>
                </label>
              </div>
            </article>

            <article class="settings-section" data-section-panel="reportes:soporte" hidden>
              <header class="settings-section-head">
                <span class="eyebrow">Soporte</span>
                <strong>Textos y datos de contacto</strong>
              </header>

              <div class="field-grid">
                <label class="form-field">
                  <span>Gerente de RRHH</span>
                  <input id="hrManagerNameInput" type="text" maxlength="300" />
                  <small class="field-help">Se usa para cartas de recomendacion y formatos de retiro.</small>
                </label>

                <label class="form-field">
                  <span>Texto de footer</span>
                  <textarea id="footerTextInput" rows="3" maxlength="1000"></textarea>
                </label>

                <label class="form-field">
                  <span>Correo de soporte</span>
                  <input id="supportEmailInput" type="email" maxlength="300" />
                </label>

                <label class="form-field">
                  <span>Telefono de soporte</span>
                  <input id="supportPhoneInput" type="text" maxlength="100" />
                </label>
              </div>
            </article>
          </div>

          <footer class="panel-actions">
            <button class="primary-button" id="saveReportButton" type="button">
              Guardar branding y reportes
            </button>
          </footer>
        </section>

        <section class="panel-card" id="securityPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Seguridad</span>
              <h3>Politicas tecnicas de acceso</h3>
            </div>
            <p class="panel-note">
              Ajusta el limite de intentos fallidos, la expiracion de sesion y la ventana de
              vigencia para recuperacion de clave.
            </p>
          </div>

          <nav class="section-switcher" aria-label="Secciones de seguridad">
            <button class="section-switch is-active" type="button" data-section-scope="seguridad" data-section-target="politicas">
              Politicas
            </button>
            <button class="section-switch" type="button" data-section-scope="seguridad" data-section-target="alcance">
              Alcance
            </button>
          </nav>

          <div class="section-stage">
            <article class="settings-section" data-section-panel="seguridad:politicas">
              <div class="field-grid field-grid-three">
                <label class="form-field">
                  <span>Intentos maximos</span>
                  <input id="securityAttemptsInput" type="number" min="1" max="20" step="1" />
                </label>

                <label class="form-field">
                  <span>Minutos de sesion</span>
                  <input id="securitySessionMinutesInput" type="number" min="1" max="1440" step="1" />
                </label>

                <label class="form-field">
                  <span>Horas recuperacion</span>
                  <input id="securityRecoveryHoursInput" type="number" min="1" max="240" step="1" />
                </label>
              </div>
            </article>

            <article class="settings-section" data-section-panel="seguridad:alcance" hidden>
              <div class="info-card">
                <strong>Que controlan estos parametros</strong>
                <small>
                  Intentos maximos bloquea al usuario despues del numero de fallos definido.
                  Minutos de sesion controla la expiracion por inactividad y Horas recuperacion
                  define cuanto dura vigente un flujo de restablecimiento.
                </small>
              </div>
              <div class="info-card">
                <strong>Buena practica</strong>
                <small>
                  Usa esta seccion solo para politicas globales. Los desbloqueos o resets puntuales
                  deben seguir haciendose desde el listado de usuarios.
                </small>
              </div>
            </article>
          </div>

          <footer class="panel-actions">
            <button class="primary-button" id="saveSecurityButton" type="button">
              Guardar parametros de seguridad
            </button>
          </footer>
        </section>

        <section class="panel-card" id="rrhhPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Capital humano</span>
              <h3>Centro de parametros de RRHH</h3>
            </div>
            <p class="panel-note">
              Toda la parametrizacion de RRHH vive aqui. El modulo operativo de Capital Humano
              queda enfocado en altas, contratos, vacaciones, horas extra, estructura y control diario.
            </p>
          </div>

          <nav class="section-switcher" aria-label="Secciones de configuracion de capital humano">
            <button class="section-switch is-active" type="button" data-section-scope="rrhh" data-section-target="catalogos">
              Catalogos base
            </button>
            <button class="section-switch" type="button" data-section-scope="rrhh" data-section-target="estructura">
              Estructura
            </button>
          </nav>

          <div class="section-stage">
            <article class="settings-section" data-section-panel="rrhh:catalogos">
              <header class="settings-section-head">
                <span class="eyebrow">Catalogos</span>
                <strong>Contratos, estados y recargos</strong>
              </header>

              <div class="launch-grid">
                <button
                  class="launch-card"
                  type="button"
                  data-open-app="/App/Rrhh"
                  data-open-group="empleados"
                  data-open-module="tipo_contrato">
                  <span class="launch-kicker">Contratos</span>
                  <strong>Tipos de contrato</strong>
                  <small>Administra la clasificacion contractual y sus codigos base.</small>
                </button>

                <button
                  class="launch-card"
                  type="button"
                  data-open-app="/App/Rrhh"
                  data-open-group="empleados"
                  data-open-module="estado_empleado">
                  <span class="launch-kicker">Estados</span>
                  <strong>Estados de empleado</strong>
                  <small>Activo, suspendido, retirado y demas estados operativos del personal.</small>
                </button>

                <button
                  class="launch-card"
                  type="button"
                  data-open-app="/App/Rrhh"
                  data-open-group="empleados"
                  data-open-module="banco">
                  <span class="launch-kicker">Bancos</span>
                  <strong>Bancos del colaborador</strong>
                  <small>Catalogo bancario usado para pagos y cuentas del personal.</small>
                </button>

                <button
                  class="launch-card"
                  type="button"
                  data-open-app="/App/Rrhh"
                  data-open-group="empleados"
                  data-open-module="tipo_hora_extra">
                  <span class="launch-kicker">Recargos</span>
                  <strong>Tipos de hora extra</strong>
                  <small>Controla la clasificacion de horas extra y sus recargos.</small>
                </button>
              </div>
            </article>

            <article class="settings-section" data-section-panel="rrhh:estructura" hidden>
              <header class="settings-section-head">
                <span class="eyebrow">Estructura</span>
                <strong>Organizacion y jornada</strong>
              </header>

              <div class="launch-grid">
                <button
                  class="launch-card"
                  type="button"
                  data-open-app="/App/Rrhh"
                  data-open-group="empleados"
                  data-open-module="departamento">
                  <span class="launch-kicker">Areas</span>
                  <strong>Departamentos</strong>
                  <small>Define gerencias, areas y unidades internas para la empresa.</small>
                </button>

                <button
                  class="launch-card"
                  type="button"
                  data-open-app="/App/Rrhh"
                  data-open-group="empleados"
                  data-open-module="cargo">
                  <span class="launch-kicker">Puestos</span>
                  <strong>Cargos</strong>
                  <small>Gestiona puestos, niveles y jerarquia base del organigrama.</small>
                </button>

                <button
                  class="launch-card"
                  type="button"
                  data-open-app="/App/Rrhh"
                  data-open-group="empleados"
                  data-open-module="horario_laboral">
                  <span class="launch-kicker">Jornadas</span>
                  <strong>Horarios laborales</strong>
                  <small>Configura turnos, horas base y jornadas operativas del personal.</small>
                </button>

                <div class="info-card">
                  <strong>Estructura general de empresa</strong>
                  <small>
                    El organigrama y las uniones entre jefe, coordinacion y subordinados se operan
                    desde RRHH en la vista de estructura, no desde esta pantalla de parametros.
                  </small>
                </div>
              </div>
            </article>
          </div>
        </section>

        <section class="panel-card" id="payrollPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Nomina</span>
              <h3>Parametros generales de planilla</h3>
            </div>
            <p class="panel-note">
              Estos valores alimentan el calculo base de INSS patronal, tratamiento de pasantias
              y conversiones generales de planilla.
            </p>
          </div>

          <nav class="section-switcher" aria-label="Secciones de parametros de nomina">
            <button class="section-switch is-active" type="button" data-section-scope="nomina" data-section-target="empresa">
              Parametros
            </button>
            <button class="section-switch" type="button" data-section-scope="nomina" data-section-target="reglas">
              Referencia
            </button>
          </nav>

          <div class="section-stage">
            <article class="settings-section" data-section-panel="nomina:empresa">
              <div class="field-grid field-grid-two">
                <label class="form-field">
                  <span>Regimen INSS empresa</span>
                  <select id="payrollRegimenInput">
                    <option value="INTEGRAL">INTEGRAL</option>
                    <option value="IVM_RP">IVM_RP</option>
                  </select>
                </label>

                <label class="form-field">
                  <span>Cantidad de trabajadores</span>
                  <input id="payrollWorkersInput" type="number" min="1" step="1" />
                </label>

                <label class="form-field">
                  <span>Modo pasantia por defecto</span>
                  <select id="payrollPasantiaModeInput">
                    <option value="NO_NOMINA">NO_NOMINA</option>
                    <option value="COMO_EMPLEADO">COMO_EMPLEADO</option>
                  </select>
                </label>

                <label class="form-field">
                  <span>Dias base de nomina</span>
                  <input id="payrollDaysInput" type="number" min="1" step="0.01" />
                </label>

                <label class="form-field">
                  <span>Horas base mensuales</span>
                  <input id="payrollHoursInput" type="number" min="1" step="0.01" />
                </label>

                <div class="info-card">
                  <strong>Nota operativa</strong>
                  <small>
                    Los logos y el nombre que use la documentacion de nomina salen del bloque de
                    branding de esta misma pantalla.
                  </small>
                </div>
              </div>
            </article>

            <article class="settings-section" data-section-panel="nomina:reglas" hidden>
              <div class="info-card">
                <strong>Reglas de calculo visibles</strong>
                <small>
                  Esta configuracion alimenta el calculo patronal, la base de salario hora,
                  el tratamiento por defecto de pasantias y el prorrateo mensual usado por planilla.
                </small>
              </div>
              <div class="info-card">
                <strong>Uso recomendado</strong>
                <small>
                  Ajusta estos valores solo cuando cambie una politica general de empresa.
                  Para montos puntuales por colaborador, usa movimientos variables, descuentos o contratos.
                </small>
              </div>
            </article>
          </div>

          <footer class="panel-actions">
            <button class="primary-button" id="savePayrollButton" type="button">
              Guardar parametros de nomina
            </button>
          </footer>
        </section>

        <section class="panel-card" id="exchangePanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Moneda</span>
              <h3>Tipo de cambio oficial e institucional</h3>
            </div>
            <p class="panel-note">
              Importa la plantilla del BCN por mes o por ano completo, y define tambien el
              tipo de cambio paralelo que la empresa usa para comprar y vender dolares.
            </p>
          </div>

          <section class="metrics-grid exchange-metrics-grid">
            <article class="metric-card">
              <span class="metric-label">Moneda base empresa</span>
              <strong class="metric-value" id="exchangeBaseCurrency">NIO</strong>
              <small class="metric-meta" id="exchangeCompanyName">Empresa activa</small>
            </article>

            <article class="metric-card">
              <span class="metric-label">BCN oficial actual</span>
              <strong class="metric-value" id="exchangeOfficialValue">0.0000</strong>
              <small class="metric-meta" id="exchangeOfficialMeta">Sin fecha cargada</small>
            </article>

            <article class="metric-card">
              <span class="metric-label">Institucional compra</span>
              <strong class="metric-value" id="exchangeInstitutionalBuy">0.0000</strong>
              <small class="metric-meta" id="exchangeInstitutionalBuyMeta">Sin fecha cargada</small>
            </article>

            <article class="metric-card">
              <span class="metric-label">Institucional venta</span>
              <strong class="metric-value" id="exchangeInstitutionalSell">0.0000</strong>
              <small class="metric-meta" id="exchangeInstitutionalSellMeta">Sin fecha cargada</small>
            </article>
          </section>

          <nav class="section-switcher" aria-label="Secciones de tipo de cambio">
            <button class="section-switch is-active" type="button" data-section-scope="tipo-cambio" data-section-target="oficial">
              BCN oficial
            </button>
            <button class="section-switch" type="button" data-section-scope="tipo-cambio" data-section-target="institucional">
              Institucional
            </button>
            <button class="section-switch" type="button" data-section-scope="tipo-cambio" data-section-target="historial">
              Historial
            </button>
          </nav>

          <div class="section-stage">
            <article class="settings-section" data-section-panel="tipo-cambio:oficial">
              <header class="settings-section-head">
                <span class="eyebrow">BCN</span>
                <strong>Importacion oficial</strong>
              </header>

              <div class="field-grid">
                <div class="info-card">
                  <strong>Plantilla aceptada</strong>
                  <small>
                    Puedes subir el archivo mensual o el archivo anual del BCN. Si seleccionas varios
                    archivos mensuales, tambien se importan en una sola corrida.
                  </small>
                </div>

                <div class="upload-card">
                  <div class="upload-copy">
                    <strong>Archivo oficial BCN</strong>
                    <small>
                      El sistema detecta la plantilla exportada en XLS/HTML y carga cada fecha
                      contra las tablas oficiales e historicas.
                    </small>
                  </div>

                  <div class="upload-actions">
                    <button class="primary-button" id="uploadOfficialRateButton" type="button">
                      Importar archivo BCN
                    </button>
                    <input id="officialRateUploadInput" type="file" accept=".xls,.html,.htm" multiple hidden />
                  </div>
                </div>

                <div class="info-card">
                  <strong>Ultimo lote importado</strong>
                  <small id="exchangeOfficialBatchMeta">
                    Aun no hay importaciones registradas de tipo de cambio oficial.
                  </small>
                </div>
              </div>
            </article>

            <article class="settings-section" data-section-panel="tipo-cambio:institucional" hidden>
              <header class="settings-section-head">
                <span class="eyebrow">Paralelo</span>
                <strong>Tipo de cambio institucional</strong>
              </header>

              <div class="field-grid field-grid-two">
                <label class="form-field">
                  <span>Fecha tipo cambio</span>
                  <input id="institutionalDateInput" type="date" />
                </label>

                <label class="form-field">
                  <span>Referencia</span>
                  <input id="institutionalReferenceInput" type="number" min="0" step="0.0001" />
                </label>

                <label class="form-field">
                  <span>Compra empresa</span>
                  <input id="institutionalBuyInput" type="number" min="0" step="0.0001" />
                </label>

                <label class="form-field">
                  <span>Venta empresa</span>
                  <input id="institutionalSellInput" type="number" min="0" step="0.0001" />
                </label>

                <label class="form-field field-span-2">
                  <span>Observacion</span>
                  <textarea id="institutionalObservationInput" rows="3" maxlength="500"></textarea>
                </label>
              </div>

              <footer class="panel-actions panel-actions-inline">
                <button class="primary-button" id="saveInstitutionalRateButton" type="button">
                  Guardar tipo de cambio institucional
                </button>
              </footer>
            </article>
          </div>

          <div class="settings-grid settings-grid-compact" data-section-panel="tipo-cambio:historial" hidden>
            <article class="settings-section">
              <header class="settings-section-head">
                <span class="eyebrow">Historial</span>
                <strong>Ultimos oficiales BCN</strong>
              </header>

              <div class="table-wrap compact-table-wrap">
                <table class="data-table compact-table">
                  <thead>
                    <tr>
                      <th>Fecha</th>
                      <th>Valor</th>
                      <th>Fuente</th>
                      <th>Archivo</th>
                    </tr>
                  </thead>
                  <tbody id="officialRateHistoryBody"></tbody>
                </table>
              </div>
              <p class="empty-state" id="officialRateHistoryEmpty" hidden>No hay historial oficial para mostrar.</p>
            </article>

            <article class="settings-section">
              <header class="settings-section-head">
                <span class="eyebrow">Historial</span>
                <strong>Ultimos institucionales</strong>
              </header>

              <div class="table-wrap compact-table-wrap">
                <table class="data-table compact-table">
                  <thead>
                    <tr>
                      <th>Fecha</th>
                      <th>Compra</th>
                      <th>Venta</th>
                      <th>Referencia</th>
                      <th>Usuario</th>
                    </tr>
                  </thead>
                  <tbody id="institutionalRateHistoryBody"></tbody>
                </table>
              </div>
              <p class="empty-state" id="institutionalRateHistoryEmpty" hidden>No hay historial institucional para mostrar.</p>
            </article>
          </div>
        </section>

        <section class="panel-card" id="conamiPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Regulacion</span>
              <h3>Catalogos y reglas CONAMI</h3>
            </div>
            <p class="panel-note">
              Las normas quedan como fuentes auditables y las reglas operativas se editan por cajon
              para que Clientes, Solicitudes, expediente, plan de pago y reportes usen parametros.
            </p>
          </div>

          <nav class="section-switcher" aria-label="Cajones de reglas CONAMI">
            <button class="section-switch is-active" type="button" data-section-scope="conami" data-section-target="riesgo-cliente">
              Riesgo cliente
            </button>
            <button class="section-switch" type="button" data-section-scope="conami" data-section-target="credito">
              Solicitud credito
            </button>
            <button class="section-switch" type="button" data-section-scope="conami" data-section-target="expediente">
              Expediente
            </button>
            <button class="section-switch" type="button" data-section-scope="conami" data-section-target="mora">
              Cartera y mora
            </button>
            <button class="section-switch" type="button" data-section-scope="conami" data-section-target="reportes">
              Reporteria
            </button>
          </nav>

          <div class="conami-source-grid" id="conamiNormsGrid"></div>

          <div class="section-stage">
            <article class="settings-section" data-section-panel="conami:riesgo-cliente">
              <header class="settings-section-head">
                <span class="eyebrow">Clientes</span>
                <strong>Riesgo, PEP y debida diligencia</strong>
              </header>
              <div class="table-wrap conami-table-wrap">
                <table class="data-table conami-rules-table">
                  <thead>
                    <tr>
                      <th>Regla</th>
                      <th>Valor</th>
                      <th>Tipo</th>
                      <th>Severidad</th>
                      <th>Activa</th>
                    </tr>
                  </thead>
                  <tbody id="conamiRulesClientBody"></tbody>
                </table>
              </div>
            </article>

            <article class="settings-section" data-section-panel="conami:credito" hidden>
              <header class="settings-section-head">
                <span class="eyebrow">Credito</span>
                <strong>Check de aprobacion y comite</strong>
              </header>
              <div class="table-wrap conami-table-wrap">
                <table class="data-table conami-rules-table">
                  <thead>
                    <tr>
                      <th>Regla</th>
                      <th>Valor</th>
                      <th>Tipo</th>
                      <th>Severidad</th>
                      <th>Activa</th>
                    </tr>
                  </thead>
                  <tbody id="conamiRulesCreditBody"></tbody>
                </table>
              </div>
            </article>

            <article class="settings-section" data-section-panel="conami:expediente" hidden>
              <header class="settings-section-head">
                <span class="eyebrow">Expediente</span>
                <strong>Documentacion minima</strong>
              </header>
              <div class="table-wrap conami-table-wrap">
                <table class="data-table conami-rules-table">
                  <thead>
                    <tr>
                      <th>Regla</th>
                      <th>Valor</th>
                      <th>Tipo</th>
                      <th>Severidad</th>
                      <th>Activa</th>
                    </tr>
                  </thead>
                  <tbody id="conamiRulesFileBody"></tbody>
                </table>
              </div>
            </article>

            <article class="settings-section" data-section-panel="conami:mora" hidden>
              <header class="settings-section-head">
                <span class="eyebrow">Cartera</span>
                <strong>Clasificacion, mora y seguimiento</strong>
              </header>
              <div class="table-wrap conami-table-wrap">
                <table class="data-table conami-rules-table">
                  <thead>
                    <tr>
                      <th>Regla</th>
                      <th>Valor</th>
                      <th>Tipo</th>
                      <th>Severidad</th>
                      <th>Activa</th>
                    </tr>
                  </thead>
                  <tbody id="conamiRulesPortfolioBody"></tbody>
                </table>
              </div>
            </article>

            <article class="settings-section" data-section-panel="conami:reportes" hidden>
              <header class="settings-section-head">
                <span class="eyebrow">Reportes</span>
                <strong>PDF, Excel, expediente y plan de pago</strong>
              </header>
              <div class="table-wrap conami-table-wrap">
                <table class="data-table conami-rules-table">
                  <thead>
                    <tr>
                      <th>Regla</th>
                      <th>Valor</th>
                      <th>Tipo</th>
                      <th>Severidad</th>
                      <th>Activa</th>
                    </tr>
                  </thead>
                  <tbody id="conamiRulesReportsBody"></tbody>
                </table>
              </div>
            </article>
          </div>

          <footer class="panel-actions">
            <button class="primary-button" id="saveConamiRulesButton" type="button">
              Guardar reglas CONAMI
            </button>
          </footer>
        </section>

        <section class="panel-card" id="creditProductsPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Colocacion</span>
              <h3>Tipos de credito y tasas oficiales</h3>
            </div>
            <p class="panel-note">
              Estas tasas alimentan solicitud, simulador, desembolso y plan de pago. En colocacion no se editan manualmente.
            </p>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Tipo</th>
                  <th>Moneda</th>
                  <th>Monto</th>
                  <th>Plazo</th>
                  <th>Interes anual</th>
                  <th>Comision desembolso</th>
                  <th>Frecuencia</th>
                  <th>Accion</th>
                </tr>
              </thead>
              <tbody id="creditProductsBody"></tbody>
            </table>
          </div>
          <div class="empty-state" id="creditProductsEmpty" hidden>
            No hay tipos de credito activos configurados.
          </div>
        </section>

        <section class="panel-card" id="usersPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Usuarios</span>
              <h3>Credenciales creadas para el personal</h3>
            </div>
            <p class="panel-note">
              La clave temporal se restablece con el mismo usuario y tambien puedes marcar
              los modulos visibles para cada colaborador o desbloquear cuentas bloqueadas.
            </p>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Cargo</th>
                  <th>Usuario</th>
                  <th>Rol</th>
                  <th>Estado</th>
                  <th>Ultimo acceso</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody id="usersTableBody"></tbody>
            </table>
          </div>
          <p class="empty-state" id="usersEmptyState" hidden>No hay usuarios para mostrar.</p>
        </section>

        <section class="panel-card" id="accessPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Bitacora</span>
              <h3>Accesos y validaciones de inicio de sesion</h3>
            </div>
            <p class="panel-note">
              Se muestran los intentos autorizados, denegados o bloqueados mas recientes.
            </p>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Usuario</th>
                  <th>Nombre</th>
                  <th>Resultado</th>
                  <th>Detalle</th>
                  <th>Equipo</th>
                  <th>IP</th>
                </tr>
              </thead>
              <tbody id="accessTableBody"></tbody>
            </table>
          </div>
          <p class="empty-state" id="accessEmptyState" hidden>No hay eventos de acceso para mostrar.</p>
        </section>

        <section class="panel-card" id="movementPanel" hidden>
          <div class="panel-head">
            <div>
              <span class="eyebrow">Bitacora</span>
              <h3>Movimientos operativos registrados</h3>
            </div>
            <p class="panel-note">
              Incluye cambios hechos por los usuarios en los modulos que ya escriben en bitacora.
            </p>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Modulo</th>
                  <th>Proceso</th>
                  <th>Evento</th>
                  <th>Usuario</th>
                  <th>Descripcion</th>
                  <th>Referencia</th>
                </tr>
              </thead>
              <tbody id="movementTableBody"></tbody>
            </table>
          </div>
          <p class="empty-state" id="movementEmptyState" hidden>
            No hay movimientos operativos para mostrar.
          </p>
        </section>
          </div>
        </div>
      </section>
    </main>

    <div class="modal-shell" id="modulesModal" hidden>
      <div class="modal-backdrop"></div>
      <section class="modal-card" aria-labelledby="modulesModalTitle">
        <header class="modal-head">
          <div>
            <span class="eyebrow">Permisos por modulo</span>
            <h3 id="modulesModalTitle">Accesos del usuario</h3>
            <p class="panel-note" id="modulesModalNote">
              Selecciona los modulos que estaran visibles en su dashboard.
            </p>
          </div>

          <button class="ghost-button" id="closeModulesModal" type="button">
            Cerrar
          </button>
        </header>

        <div class="modal-status-row">
          <span class="status-pill is-warning" id="modulesModeBadge">Automatico</span>
          <small class="muted" id="modulesModeHelp">
            Si no personalizas accesos, el sistema toma los modulos por rol y jefatura.
          </small>
        </div>

        <div class="modules-grid" id="modulesGrid"></div>
        <p class="empty-state" id="modulesEmptyState" hidden>
          No hay modulos disponibles para configurar.
        </p>

        <footer class="modal-actions">
          <button class="ghost-button" id="restoreAutomaticModules" type="button">
            Restaurar automatico
          </button>
          <button class="primary-button" id="saveModulesButton" type="button">
            Guardar modulos
          </button>
        </footer>
      </section>
    </div>

    <div class="toast-region" id="toastRegion" aria-live="polite"></div>

    <script src="~/js/shared/auth-session.js" asp-append-version="true"></script>
    <script src="~/js/config/config.js" asp-append-version="true"></script>
    <script src="~/js/shared/ux-guidance.js" asp-append-version="true"></script>
  </body>
</html>
